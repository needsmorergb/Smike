# Smartsheet to Wrike Migration - Environment Configuration
# Copy this file to .env and fill in your actual tokens
# DO NOT commit .env to version control!

# Smartsheet API Token
# Get your token from: https://app.smartsheet.com/account/myaccount
SMARTSHEET_ACCESS_TOKEN=your_smartsheet_token_here

# Wrike API Token
# Get your token from: https://www.wrike.com/frontend/apps/index.html#/api
WRIKE_ACCESS_TOKEN=your_wrike_token_here
